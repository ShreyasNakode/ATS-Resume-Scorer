# ==============================================================================
# ATS Resume Scorer — Environment Configuration
# ==============================================================================

# Application Settings
APP_ENV=development
APP_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://*.streamlit.app

# ==============================================================================
# NLP & BERT (Bidirectional Encoder Representations from Transformers)
# ==============================================================================
# Default BERT sentence transformer for semantic embedding matching
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
BERT_MODEL_NAME=bert-base-uncased
SPACY_MODEL_PRIMARY=en_core_web_md
SPACY_MODEL_SECONDARY=en_core_web_sm

# ==============================================================================
# Authentication — Clerk
# Get your keys at https://dashboard.clerk.com
# ==============================================================================
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# The JWKS URL from your Clerk dashboard (e.g., https://verb-noun-00.clerk.accounts.dev/.well-known/jwks.json)
CLERK_JWKS_URL=https://your-clerk-subdomain.clerk.accounts.dev/.well-known/jwks.json
# Optional: Clerk Public Key in PEM format (for offline verification)
CLERK_PEM_PUBLIC_KEY=
# Set to true to allow guest/demo user testing when Clerk keys are not provided
ENABLE_DEMO_AUTH=true

# ==============================================================================
# Database / History Storage
# Local SQLite by default (zero setup required). Supabase is optional.
# ==============================================================================
DATABASE_URL=sqlite:///./ats_history.db
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ==============================================================================
# Optional: Groq LLM API (for extended suggestions)
# ==============================================================================
GROQ_API_KEY=

# ==============================================================================
# Deployment: AWS Elastic Beanstalk & Vercel
# ==============================================================================
AWS_EB_REGION=us-east-1
PORT=8000
